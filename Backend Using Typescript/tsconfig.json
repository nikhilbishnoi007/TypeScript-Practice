{
  
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames":true,
    "strict": true,
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
